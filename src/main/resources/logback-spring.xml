<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!--
      개인정보 마스킹 변환기.

      호출부에서 PiiMasker 로 명시적으로 가리는 것이 원칙이지만, 예외 메시지는 우리가
      문장을 통제할 수 없다. DB 제약 위반 메시지에는 위반한 컬럼 값이, 외부 API 오류에는
      응답 본문이 그대로 들어온다. 최종 출력 직전에 한 번 더 훑는 안전망이다.

      %maskedMsg / %maskedEx 를 %msg / %ex 대신 사용한다.
    -->
    <conversionRule conversionWord="maskedMsg"
                    class="com.burty.core.logging.PiiMaskingConverter"/>
    <conversionRule conversionWord="maskedEx"
                    class="com.burty.core.logging.PiiMaskingThrowableConverter"/>

    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH}/application.log}"/>

    <!--
      보관 기간과 총량.

      예전에는 30일·90일·1GB 가 파일에 박혀 있어 운영에서 늘리려면 이미지를 다시 만들어야
      했다. 금융 서비스의 접속기록 보관 요구에 이 값이 맞는지는 법률 검토가 필요하므로,
      기본값은 그 전까지의 임시값으로 두고 환경변수로 바꿀 수 있게 한다.

      주의: 총량(totalSizeCap)이 기간보다 먼저 걸리면, 기간이 남아 있어도 오래된 것부터
      지워진다. 기간을 늘릴 때는 총량과 디스크 여유를 함께 올려야 한다.
    -->
    <property name="LOG_MAX_FILE_SIZE" value="${LOG_MAX_FILE_SIZE:-10MB}"/>
    <property name="LOG_MAX_HISTORY_DAYS" value="${LOG_MAX_HISTORY_DAYS:-30}"/>
    <property name="LOG_ERROR_MAX_HISTORY_DAYS" value="${LOG_ERROR_MAX_HISTORY_DAYS:-90}"/>
    <property name="LOG_TOTAL_SIZE_CAP" value="${LOG_TOTAL_SIZE_CAP:-1GB}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId}] %logger{36} - %maskedMsg%n%maskedEx</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY_DAYS}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId}] %logger{36} - %maskedMsg%n%maskedEx</pattern>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_ERROR_MAX_HISTORY_DAYS}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId}] %logger{36} - %maskedMsg%n%maskedEx</pattern>
        </encoder>
    </appender>

    <logger name="org.springframework" level="INFO"/>
    <logger name="com.zaxxer" level="INFO"/>
    <logger name="org.hibernate" level="INFO"/>
    <logger name="io.swagger" level="ERROR"/>
    <logger name="org.springdoc" level="ERROR"/>

    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <springProfile name="local">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
