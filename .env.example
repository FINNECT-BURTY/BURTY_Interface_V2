# BURTY 환경변수 예시 — .env 로 복사 후 값을 채우세요.
# cp .env.example .env

SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_DDLAUTO=update

DB_HOST=localhost
DB_PORT=3306
DB_NAME=burty
DB_USER=root
DB_PASSWORD=your-db-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BURTY_REDIS_ENABLED=false

JWT_SECRET=replace-with-256bit-random-secret
BURTY_SIGN_SECRET=replace-with-random-sign-secret
ADMIN_SETUP_KEY=replace-with-admin-setup-key
BURTY_YOUTH_CENTER_API_KEY=

APP_BASE_URL=http://localhost:8080
APP_PORT=8080

BURTY_SOCIAL_STUB_MODE=true
BURTY_SOCIAL_KAKAO_CLIENT_ID=
BURTY_SOCIAL_KAKAO_CLIENT_SECRET=
BURTY_SOCIAL_GOOGLE_CLIENT_ID=
BURTY_SOCIAL_GOOGLE_CLIENT_SECRET=
BURTY_SOCIAL_NAVER_CLIENT_ID=
BURTY_SOCIAL_NAVER_CLIENT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

HOST_LOG_DIR=./logs
HOST_UPLOAD_DIR=./uploads
LOG_PATH=./logs

OPENAI_API_KEY=
BURTY_AI_OPENAI_STUB_MODE=true

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
GRAFANA_PUBLIC_URL=http://localhost:3001
GRAFANA_ROOT_URL=http://localhost:3001
BURTY_GRAFANA_ENABLED=false
MANAGEMENT_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
