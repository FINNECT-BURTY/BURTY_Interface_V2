# cp .env.example .env 후 docker compose up -d --build

SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080

DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=burty
DB_USER=root
DB_PASSWORD=your-mariadb-password

JWT_SECRET=change-me-jwt-secret-key-minimum-256-bits
BURTY_REDIS_ENABLED=false

FRONTEND_URL=http://localhost:8080
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# 서버 + nginx-proxy 사용 시
# VIRTUAL_HOST=44.194.3.230,api.burty.kr
# LETSENCRYPT_HOST=api.burty.kr

# GCP (선택) — secrets/keys.json 경로
# GCP_KEYS_FILE=./secrets/keys.json
# GEMINI_ENABLED=true
# GEMINI_PROJECT_ID=your-project-id
