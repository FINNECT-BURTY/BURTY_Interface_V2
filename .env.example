# BURTY 환경변수 예시 — .env 로 복사 후 값을 채우세요.
# cp .env.example .env

SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_DDLAUTO=update

DB_HOST=localhost
DB_PORT=3306
DB_NAME=burty
DB_USER=root
DB_PASSWORD=your-db-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BURTY_REDIS_ENABLED=false

JWT_SECRET=replace-with-256bit-random-secret
BURTY_SIGN_SECRET=replace-with-random-sign-secret
ADMIN_SETUP_KEY=replace-with-admin-setup-key
BURTY_YOUTH_CENTER_API_KEY=

APP_BASE_URL=http://localhost:8080
APP_PORT=8080

BURTY_SOCIAL_STUB_MODE=true
BURTY_SOCIAL_KAKAO_CLIENT_ID=
BURTY_SOCIAL_KAKAO_CLIENT_SECRET=
BURTY_SOCIAL_GOOGLE_CLIENT_ID=
BURTY_SOCIAL_GOOGLE_CLIENT_SECRET=
BURTY_SOCIAL_NAVER_CLIENT_ID=
BURTY_SOCIAL_NAVER_CLIENT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

HOST_LOG_DIR=./logs
LOG_PATH=./logs

# 로그 보관. 운영 compose 는 더 긴 값을 쓴다 (180일 / 365일 / 5GB).
# 총량이 기간보다 먼저 걸리면 기간이 남아 있어도 오래된 것부터 지워진다.
LOG_MAX_HISTORY_DAYS=30
LOG_ERROR_MAX_HISTORY_DAYS=90
LOG_TOTAL_SIZE_CAP=1GB

OPENAI_API_KEY=
BURTY_AI_OPENAI_STUB_MODE=true

# 알람 수신 웹훅 (Slack·Teams·Discord 등). 비우면 알람이 아무 곳에도 가지 않는다.
ALERT_WEBHOOK_URL=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
GRAFANA_PUBLIC_URL=http://localhost:3001
GRAFANA_ROOT_URL=http://localhost:3001
BURTY_GRAFANA_ENABLED=false
MANAGEMENT_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
